PORT=3000
VLINK_PUBLIC_ORIGIN=http://localhost:3000
VLINK_PAIRING_ORIGIN=http://localhost:3002
VLINK_CORS_ORIGIN=http://localhost:3000
VLINK_STATE_PATH=.runtime/vlink-state.json
VLINK_LOCKERPHYCER_URL=http://127.0.0.1:8092
VLINK_ANONYMOUS_BOOTSTRAP_ENABLED=false
# Required when anonymous bootstrap is enabled in production; use a stable random value of at least 32 bytes.
VLINK_BOOTSTRAP_RATE_LIMIT_KEY=
# Only set exact proxy CIDRs when this service is behind a trusted reverse proxy.
VLINK_TRUST_PROXY_CIDRS=
GEMINI_API_KEY=
GEMINI_MODEL=
VLINK_ENABLE_DEMO_RESPONSES=false
VLINK_ALLOWED_TARGET_HOSTS=
# Required in production for protected durable credentials and governed leases; keep stable across restarts.
VLINK_LEASE_SEALING_KEY=
VLINK_CAPI_BASE_URL=
